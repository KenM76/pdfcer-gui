# Build output
/target
**/target

# ui-verify artefacts — screenshots and diag traces are evidence for a
# single run, not source. Anything worth keeping is copied to evidence/.
/tools/ui-verify/out
*.diag.txt

# ★★★ A SWEEP's own output directory. 2026-08-28: one four-attempt sweep left
# 257 MB across 324 files under `evidence/sweep-*`, and committing it added
# 1,128,177 lines to a repository whose entire source is a fraction of that.
#
# ⇒ The distinction the block above already draws, applied one level out: a
# TRACE is evidence for a single run and a SUMMARY is a record. Keep the
# summary — `sweep-*/‹family›.txt`, a few hundred lines naming what passed —
# and never the per-check traces and PNGs behind it.
#
# ★ The operator's disk is tight and `target/` already grows unbounded; a
# habit of committing run output is the same problem in a place nothing prunes.
/evidence/sweep-*/*/
/evidence/sweep-*/*.png

# OS / editor
Thumbs.db
.DS_Store
.tmpwork/

# Cygwin/MSYS crash dumps, produced by the shell rather than by this project.
*.stackdump

# Python bytecode from the gate instruments. Importing `verb-coverage.py` to
# spot-check its matcher on 2026-09-05 left a `tools/__pycache__/` behind that
# `git status` then reported as untracked source.
__pycache__/
*.pyc
